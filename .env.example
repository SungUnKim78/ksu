# PostgreSQL 연결 주소 (Neon, Supabase, Vercel Postgres 등). 표는 첫 접속 때 자동으로 만들어집니다.
DATABASE_URL=postgres://user:password@host:5432/dbname

# 관리자 화면(/admin) 비밀번호
ADMIN_PASSWORD=

# 로그인 쿠키 서명용 임의의 긴 문자열
SESSION_SECRET=

# (선택) 카카오 로그인. 비워두면 카카오 버튼이 표시되지 않습니다.
# 카카오 개발자 콘솔의 REST API 키, Redirect URI는 https://내도메인/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# (선택) QR과 재주문 링크에 쓸 사이트 주소. 비워두면 접속한 주소를 그대로 사용합니다.
SITE_URL=
